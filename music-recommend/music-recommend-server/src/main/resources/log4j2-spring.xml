<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- 定义日志格式 -->
        <!--        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>-->
        <!--                <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} | [%X{requestId} | (%-5level) | (%thread) | (%logger) | %msg%n</Property>-->
        <Property name="LOG_PATTERN">%style{%d{yyyy-MM-dd HH:mm:ss}}{bright,green}
            %highlight{%-5level}[%style{%t}{bright,blue}] %style{%C{}}{bright,yellow}: %msg%n%style{%throwable}{red}
        </Property>

        <!-- 定义日志文件路径 -->
        <Property name="LOG_DIR">${spring:logging.file.path:-./logs}</Property>
        <Property name="APP_NAME">${spring:logging.file.name:-app}</Property>
    </Properties>

    <!-- 定义日志输出目的地（Appenders） -->
    <Appenders>
        <!-- 1. 控制台输出 Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <!-- 日志格式：时间 - 线程名 - 级别 - 类名 - 消息 -->
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <!-- 只输出INFO及以上级别到控制台（避免DEBUG日志刷屏） -->
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>

        <!-- 2. 滚动文件输出 Appender（按大小+时间滚动，避免单个文件过大） -->
        <RollingFile
                name="RollingFileInfo"
                fileName="${LOG_DIR}/${APP_NAME}-info.log"
                filePattern="${LOG_DIR}/${APP_NAME}-info-%d{yyyy-MM-dd}-%i.log.gz">  <!-- 归档文件路径（按天+序号，gz压缩） -->

            <!-- 日志格式（更详细，包含行号，方便定位问题） -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{50}:%L - %msg%n"/>

            <!-- 只接收INFO级别日志 -->
            <Filters>
                <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="NEUTRAL"/>
                <ThresholdFilter level="WARN" onMatch="DENY" onMismatch="DENY"/> <!-- 拒绝WARN及以上（交给其他Appender处理） -->
            </Filters>

            <!-- 滚动策略：按时间（每天）+ 按大小（单文件最大100MB） -->
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/> <!-- 每天滚动一次 -->
                <SizeBasedTriggeringPolicy size="100 MB"/> <!-- 单文件超过100MB也滚动 -->
            </Policies>

            <!-- 归档保留策略：最多保留30天的日志 -->
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- 3. 错误日志单独文件（ERROR及以上级别） -->
        <RollingFile
                name="RollingFileError"
                fileName="${LOG_DIR}/${APP_NAME}-error.log"
                filePattern="${LOG_DIR}/${APP_NAME}-error-%d{yyyy-MM-dd}-%i.log.gz">

            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{50}:%L - %msg%n"/>

            <!-- 只接收ERROR及以上级别 -->
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="90"/> <!-- 错误日志保留更久（90天） -->
        </RollingFile>
    </Appenders>

    <!-- 定义日志器（Loggers）：指定哪些包的日志使用哪个Appender -->
    <Loggers>
        <!-- 1. 根日志器：所有未单独配置的包默认继承此配置 -->
        <Root level="info"> <!-- 根日志级别：INFO（低于INFO的DEBUG等不输出） -->
            <AppenderRef ref="Console"/>       <!-- 输出到控制台 -->
            <AppenderRef ref="RollingFileInfo"/> <!-- 输出到INFO日志文件 -->
            <AppenderRef ref="RollingFileError"/> <!-- 输出到ERROR日志文件 -->
        </Root>

    </Loggers>
</Configuration>